# 数据库配置
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_db_password
DB_NAME=mis

# JWT 配置
JWT_SECRET_KEY=hogwarts_secret_key_2026

# Flask 配置
DEBUG=true
PORT=5000

# 测试模式开关 (true/false)
TEST_MODE=true

# 测试套件选择（仅在 TEST_MODE=true 时生效）
# "all" 或 "0" = 运行全部测试
# "auth" = 仅运行阶段一鉴权测试（注册登录）
# "professor" = 仅运行阶段一教授端业务写入测试
# "auth,professor" = 同时运行两个测试套件
TEST_SUITE=all
